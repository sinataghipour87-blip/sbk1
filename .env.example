SBK1_WHALE_MIN_ETH=100
SBK1_WHALE_ERC20_THRESHOLDS={}
# Comma-separated verified Ethereum CEX deposit addresses; required for keyless ETH RPC scanning.
SBK1_ETHERSCAN_WATCH_ADDRESSES=
# On-chain watchlists must contain only independently verified exchange deposit addresses.
# SOL/XRP/BNB JSON format: {"<verified-address>":"<exchange-name>"}. Never use example/random wallets.
# Empty watchlists fail closed even when the public RPC provider is reachable.
SBK1_SOL_WATCH_ADDRESSES={}
SBK1_XRP_WATCH_ADDRESSES={}
SBK1_BNB_WATCH_ADDRESSES={}
SBK1_WHALE_MIN_SOL=
SBK1_WHALE_MIN_XRP=
SBK1_WHALE_MIN_BNB=
SBK1_WHALE_BLOCK_SAMPLE_COUNT=3
SBK1_WHALE_REQUEST_TIMEOUT_MS=5000
SBK1_WHALE_MAX_AGE_MS=1200000
# Operator-provided base reaction coefficients; validate with historical out-of-sample analysis before production use.
SBK1_MACRO_BETA_BY_PAIR="BTC/USDT:USDT=1.00,ETH/USDT:USDT=1.05,SOL/USDT:USDT=1.30,XRP/USDT:USDT=1.20,BNB/USDT:USDT=1.15"