# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# MULTI-KEY SUPPORT: You can add multiple Gemini keys to increase quota.
# The system will automatically detect any variable starting with GEMINI_KEY_
# Examples:
# GEMINI_KEY_1="your_key_here"
# GEMINI_KEY_2="your_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-applet.run.app"

# BYBIT_API_KEY & BYBIT_API_SECRET (Optional for Live Mainnet/Testnet Execution)
BYBIT_API_KEY=""
BYBIT_API_SECRET=""
BYBIT_IS_TESTNET="true"

# SECURITY: High-Precision Trading Engine Credentials
ADMIN_TOKEN="your_secure_admin_token_here"
EXCHANGE_VAULT_KEY="your_secure_vault_encryption_key_here"
